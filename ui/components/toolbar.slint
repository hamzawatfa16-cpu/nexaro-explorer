import { Colors } from "../theme/colors.slint";
import { LineEdit } from "std-widgets.slint";
import { UiBreadcrumb } from "../shared/breadcrumbs.slint";

component ToolButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 10px;
    border-width: 1px;
    border-color: touch.has-hover ? #2f4056 : Colors.border;

    background: touch.pressed
        ? #17304a
        : (touch.has-hover ? #111c2a : Colors.content);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: Colors.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 15px;
        font-weight: 600;
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 36px;
    min-width: 92px;
    border-radius: 10px;
    border-width: 1px;
    border-color: touch.has-hover ? #2f4056 : Colors.border;

    background: touch.pressed
        ? #17304a
        : (touch.has-hover ? #111c2a : Colors.content);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: Colors.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 600;
    }
}

export component Toolbar inherits Rectangle {
    in property <[UiBreadcrumb]> breadcrumbs;
    in property <string> current_path: "This PC";

    callback back();
    callback forward();
    callback up();
    callback refresh();
    callback new_folder();
    callback rename();
    callback delete_selected();
    callback search_changed(query: string);
    callback breadcrumb_clicked(path: string);

    height: 68px;
    background: Colors.window;

    Rectangle {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: 48px;
        border-radius: 16px;
        background: Colors.toolbar;
        border-width: 1px;
        border-color: Colors.border;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;

            ToolButton {
                text: "←";
                clicked => { root.back(); }
            }

            ToolButton {
                text: "→";
                clicked => { root.forward(); }
            }

            ToolButton {
                text: "↑";
                clicked => { root.up(); }
            }

            ToolButton {
                text: "⟳";
                clicked => { root.refresh(); }
            }

            Rectangle {
                width: 1px;
                height: 22px;
                background: Colors.border;
            }

            ActionButton {
                text: "New";
                clicked => { root.new_folder(); }
            }

            ActionButton {
                text: "Rename";
                clicked => { root.rename(); }
            }

            ActionButton {
                text: "Delete";
                clicked => { root.delete_selected(); }
            }

            Rectangle {
                width: 1px;
                height: 22px;
                background: Colors.border;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: 12px;
                background: Colors.content;
                border-width: 1px;
                border-color: Colors.border;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;

                    for crumb[i] in root.breadcrumbs : HorizontalLayout {
                        spacing: 6px;

                        Rectangle {
                            height: 26px;
                            border-radius: 8px;
                            background: touch.has-hover ? #142235 : Colors.content;

                            touch := TouchArea {
                                clicked => {
                                    root.breadcrumb_clicked(crumb.path);
                                }
                            }

                            Text {
                                text: crumb.label;
                                color: Colors.text;
                                vertical-alignment: center;
                                font-weight: 600;
                                x: 10px;
                                width: parent.width - 20px;
                            }
                        }

                        if i < root.breadcrumbs.length - 1 : Text {
                            text: "›";
                            color: Colors.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                width: 260px;
                height: 36px;
                border-radius: 12px;
                background: Colors.content;
                border-width: 1px;
                border-color: Colors.border;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    Text {
                        text: "🔍";
                        color: Colors.text_secondary;
                        vertical-alignment: center;
                        width: 16px;
                    }

                    LineEdit {
                        horizontal-stretch: 1;
                        height: 20px;
                        placeholder-text: "Search files";

                        edited(text) => {
                            root.search_changed(text);
                        }
                    }
                }
            }
        }
    }
}
