import { Colors } from "../theme/colors.slint";
import { SidebarItem } from "sidebar-item.slint";

export component Sidebar inherits Rectangle {
    callback home();
    callback quick_access();
    callback this_pc();
    callback desktop();
    callback documents();
    callback downloads();
    callback pictures();
    callback music();
    callback videos();
    callback network();
    callback toggle();

    in property <string> current: "Home";
    in property <bool> compact: false;

    width: compact ? 64px : 220px;
    background: Colors.sidebar;
    border-width: 1px;
    border-color: Colors.border;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        Rectangle {
            width: compact ? 44px : 196px;
            height: 40px;
            border-radius: 10px;
            background: toggle_touch.has-hover ? #101d2d : Colors.sidebar;
            border-width: 1px;
            border-color: Colors.border;

            toggle_touch := TouchArea {
                clicked => { root.toggle(); }
            }

            HorizontalLayout {
                padding-left: compact ? 0px : 12px;
                padding-right: compact ? 0px : 12px;
                spacing: 10px;

                Text {
                    text: compact ? "Menu" : "Toggle Sidebar";
                    color: Colors.text;
                    vertical-alignment: center;
                    horizontal-alignment: compact ? center : start;
                    font-weight: 600;
                }
            }
        }

        Rectangle { height: 8px; background: Colors.sidebar; }

        SidebarItem { icon: "H"; text: "Home"; selected: root.current == "Home"; compact: root.compact; clicked => { root.home(); } }
        SidebarItem { icon: "QA"; text: "Quick Access"; selected: root.current == "Quick Access"; compact: root.compact; clicked => { root.quick_access(); } }
        SidebarItem { icon: "PC"; text: "This PC"; selected: root.current == "This PC"; compact: root.compact; clicked => { root.this_pc(); } }
        SidebarItem { icon: "D"; text: "Desktop"; selected: root.current == "Desktop"; compact: root.compact; clicked => { root.desktop(); } }

        Rectangle { height: 8px; background: Colors.sidebar; }

        SidebarItem { icon: "Doc"; text: "Documents"; selected: root.current == "Documents"; compact: root.compact; clicked => { root.documents(); } }
        SidebarItem { icon: "DL"; text: "Downloads"; selected: root.current == "Downloads"; compact: root.compact; clicked => { root.downloads(); } }
        SidebarItem { icon: "Pic"; text: "Pictures"; selected: root.current == "Pictures"; compact: root.compact; clicked => { root.pictures(); } }
        SidebarItem { icon: "M"; text: "Music"; selected: root.current == "Music"; compact: root.compact; clicked => { root.music(); } }
        SidebarItem { icon: "V"; text: "Videos"; selected: root.current == "Videos"; compact: root.compact; clicked => { root.videos(); } }

        Rectangle { height: 8px; background: Colors.sidebar; }

        SidebarItem { icon: "Net"; text: "Network"; selected: root.current == "Network"; compact: root.compact; clicked => { root.network(); } }

        Rectangle { vertical-stretch: 1; background: Colors.sidebar; }
    }
}
