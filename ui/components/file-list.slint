import { Colors } from "../theme/colors.slint";

export struct UiFileItem {
    icon: string,
    name: string,
    path: string,
    file_type: string,
    size: string,
    modified: string,
}

export component FileList inherits Rectangle {
    in property <[UiFileItem]> files;
    in-out property <int> selected_index: -1;

    callback open_folder(path: string);
    callback open_file(path: string);
    callback select_file(path: string);

    background: Colors.content;

    VerticalLayout {
        spacing: 8px;

        Rectangle {
            height: 44px;
            background: Colors.toolbar;
            border-radius: 12px;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                spacing: 0;
                padding-left: 14px;
                padding-right: 14px;

                Text {
                    text: "Name";
                    color: Colors.text_secondary;
                    width: 420px;
                    vertical-alignment: center;
                    font-weight: 600;
                    font-size: 13px;
                }

                Text {
                    text: "Type";
                    color: Colors.text_secondary;
                    width: 170px;
                    vertical-alignment: center;
                    font-weight: 600;
                    font-size: 13px;
                }

                Text {
                    text: "Size";
                    color: Colors.text_secondary;
                    width: 120px;
                    vertical-alignment: center;
                    font-weight: 600;
                    font-size: 13px;
                }

                Text {
                    text: "Modified";
                    color: Colors.text_secondary;
                    width: 190px;
                    vertical-alignment: center;
                    font-weight: 600;
                    font-size: 13px;
                }
            }
        }

        if (root.files.length == 0) : Rectangle {
            background: Colors.content;
            border-radius: 16px;
            border-width: 1px;
            border-color: Colors.border;

            VerticalLayout {
                alignment: center;
                spacing: 12px;
                padding: 24px;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 20px;
                    background: Colors.toolbar;
                    border-width: 1px;
                    border-color: Colors.border;

                    Text {
                        text: "📁";
                        color: Colors.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 28px;
                    }
                }

                Text {
                    text: "This folder is empty";
                    color: Colors.text;
                    horizontal-alignment: center;
                    font-weight: 700;
                    font-size: 16px;
                }

                Text {
                    text: "Create a folder or copy files here";
                    color: Colors.text_secondary;
                    horizontal-alignment: center;
                }
            }
        }

        for file[i] in root.files : Rectangle {
            height: 52px;
            background: i == root.selected_index
                ? Colors.accent_soft
                : (touch.has-hover ? Colors.toolbar : Colors.content);
            border-width: 1px;
            border-color: i == root.selected_index ? Colors.accent : #00000000;
            border-radius: 12px;

            touch := TouchArea {
                clicked => {
                    root.selected_index = i;
                    root.select_file(file.path);
                }

                double-clicked => {
                    if (file.file_type == "Directory") {
                        root.open_folder(file.path);
                    } else {
                        root.open_file(file.path);
                    }
                }
            }

            HorizontalLayout {
                spacing: 0;
                padding-left: 14px;
                padding-right: 14px;

                Rectangle {
                    width: 44px;
                    height: parent.height;
                    background: #00000000;

                    Text {
                        text: file.icon;
                        color: Colors.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 18px;
                    }
                }

                Text {
                    text: file.name;
                    color: Colors.text;
                    width: 376px;
                    vertical-alignment: center;
                    font-weight: 600;
                }

                Text {
                    text: file.file_type;
                    color: Colors.text_secondary;
                    width: 170px;
                    vertical-alignment: center;
                }

                Text {
                    text: file.size;
                    color: Colors.text_secondary;
                    width: 120px;
                    vertical-alignment: center;
                }

                Text {
                    text: file.modified;
                    color: Colors.text_secondary;
                    width: 190px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: Colors.content;
        }
    }
}
