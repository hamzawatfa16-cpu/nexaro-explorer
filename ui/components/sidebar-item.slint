import { Colors } from "../theme/colors.slint";

export component SidebarItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> compact: false;

    callback clicked();

    width: compact ? 48px : 196px;
    height: 40px;
    border-radius: 10px;

    background: selected
        ? Colors.accent_soft
        : (touch.has-hover ? #101d2d : Colors.sidebar);
    border-width: selected ? 1px : 0px;
    border-color: selected ? Colors.accent : #00000000;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: compact ? 0px : 12px;
        padding-right: compact ? 0px : 12px;
        spacing: 10px;

        Text {
            text: root.icon;
            color: Colors.text;
            width: 28px;
            font-weight: 700;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !root.compact : Text {
            text: root.text;
            color: Colors.text;
            vertical-alignment: center;
            font-size: 14px;
        }
    }
}
